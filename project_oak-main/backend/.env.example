# Use MongoDB Atlas or a replica set because stock changes use transactions.
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project_oak?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET_KEY=replace-with-a-separate-admin-registration-secret
SEED_PASSWORD=choose-a-long-password-for-demo-accounts